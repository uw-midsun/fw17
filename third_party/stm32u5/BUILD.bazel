load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "system",
    srcs = ["system_stm32u5xx.c"],
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:armv8-m",
    ],
    deps = ["@cmsis-device-u5//:system"],
    alwayslink = True,
)

cc_library(
    name = "stm32u5xx_hal_conf",
    hdrs = ["stm32u5xx_hal_conf.h"],
    include_prefix = "stm32u5xx_hal",
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:armv8-m",
    ],
)
