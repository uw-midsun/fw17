load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "template_config",
    hdrs = ["examples/template_configuration/FreeRTOSConfig.h"],
    includes = ["examples/template_configuration"],
)

label_flag(
    name = "freertos_config",
    build_setting_default = ":template_config",
)

### kernels
CM33_NTZ = "portable/GCC/ARM_CM33_NTZ/non_secure/"

cc_library(
    name = "kernel",
    srcs = [
        "croutine.c",
        "event_groups.c",
        "list.c",
        "queue.c",
        "stream_buffer.c",
        "tasks.c",
        "timers.c",
        CM33_NTZ + "port.c",
        CM33_NTZ + "portasm.c",
    ],
    hdrs = glob([
        "include/*.h",
        CM33_NTZ + "*.h",
    ]),
    deps = [":freertos_config"],
)
