load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "stm32g4xx_hal",
    srcs = glob(
        ["Src/**/*.c"],
        exclude = ["Src/**/*template*.c"],
    ),
    hdrs = glob(
        ["Inc/**/*.h"],
        exclude = ["Inc/**/*template*.h"],
    ),
    deps = ["@cmsis-device-g4//:system"],
    includes = ["Inc"],
    include_prefix = "stm32g4xx_hal",
    strip_include_prefix = "Inc",
)
